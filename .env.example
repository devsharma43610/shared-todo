# Optional overrides for docker-compose.yml — copy to .env to change any of them.
# `docker compose up --build` works without this file.

# ---------- PostgreSQL ----------
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=shared_todo
POSTGRES_PORT=5432

# ---------- Firebase ----------
# A "demo-" project ID tells Firebase to run fully offline against the Auth Emulator.
FIREBASE_PROJECT_ID=demo-shared-todo
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-shared-todo.firebaseapp.com
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# ---------- Ports / misc ----------
BACKEND_PORT=3000
FRONTEND_PORT=8080
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
LOG_LEVEL=info
