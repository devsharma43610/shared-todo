# Copy to apps/frontend/.env when running the frontend outside Docker (npm run dev:frontend).
# In Docker these are passed as build args from the root .env (see docker-compose.yml).

# The frontend calls same-origin /api; Vite (dev) and nginx (Docker) proxy it to the backend.
VITE_API_BASE_URL=/api

# Firebase web config. With the Auth Emulator any non-empty API key works.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-shared-todo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-shared-todo

# Leave empty to use a real Firebase project instead of the emulator.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
