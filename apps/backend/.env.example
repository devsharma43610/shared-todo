# Copy to apps/backend/.env when running the backend outside Docker (npm run dev:backend).

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (docker compose exposes it on localhost:5432)
DATABASE_URL=postgresql://todo:todo@localhost:5432/shared_todo

# Firebase — "demo-*" project IDs work with the Auth Emulator and need no real credentials.
FIREBASE_PROJECT_ID=demo-shared-todo
# Remove this line to verify tokens against a real Firebase project instead of the emulator.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Comma-separated list of allowed origins, or * to allow any (dev only)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Only used by the integration test (npm test). Point it at a separate, migrated database.
# TEST_DATABASE_URL=postgresql://todo:todo@localhost:5432/shared_todo_test
